<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：dev 阶段后端是 http://10.0.2.2:8000（明文 HTTP），
  Android 9（API 28）起默认禁止明文流量，不放开会表现为「所有请求失败但没有任何明显报错」。

  这里**只对本地开发地址**放开明文，生产域名仍强制 HTTPS：
  上架前把 debug 的 cleartext 关掉即可（或改用 https 域名后删除本文件）。

  10.0.2.2 = Android 模拟器/MuMu 访问宿主机的固定映射地址。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
