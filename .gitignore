# dependencies
node_modules/

# build output
dist/
docs/.vitepress/dist/
docs/.vitepress/cache/

# go
server/bin/
server/uploads/
server/uploads_staging/
server/uploads_prod/
*.exe
*.test
*.out
*.bin

# temp/测试产物（脚本生成的临时媒体与下载件）
tmp_*
server/tmp_*
# Go 构建缓存（沙箱会话 GOCACHE 指入工作区时产生）
.gocache/
# 同上，带后缀的会话级构建缓存/产物目录（GOCACHE 落不进 .gocache 时的替代路径）
.gocache-dsh/
# npm 缓存（沙箱会话把 npm cache 指入工作区时产生）
.npm-cache/
# 沙箱会话的运行时工作目录（推流/切片/证据等，脚本自建）
.liv01-run/
.pay02run/
# 直播回放（M4-LIV-14）会话运行时目录：本地 MySQL/Redis 数据、DVR 录制、上传产物
.liv14-run/
# SRS DVR 运行时录制的原始文件（*.flv 体积大且属运行时产物；目录本身由 README/.gitkeep 保住）
server/deploy/srs/dvr/**/*.flv

# 会话归档解包与本地环境探测产物（含安装包，不入库）
.session-extract/
# pnpm 本地存储（若被置于仓库根目录）
.pnpm-store/

# dev-all 一键启动的服务日志（每次运行覆盖）
.dev-logs/

# 本地设计参考图（AI 生成的概念图，仅作设计对照，不入库）
vibe_images/

# env & local
.env
.env.local
*.local

# editor / os
.idea/
.vscode/
.DS_Store
Thumbs.db

# logs
*.log
pnpm-debug.log*
